package com.jgames.demo.minesweeper.controller;

import java.util.List;

import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.ResponseBody;

import com.jgames.demo.minesweeper.vo.request.MinesweeperRequest;
import com.jgames.demo.minesweeper.vo.response.MinesweeperResponse;
import com.jgames.demo.minesweeper.vo.response.OpenCell;
import com.jgames.demo.minesweeper.vo.response.ResultType;

@Controller
public class MinesweeperController {
	
	@GetMapping("/minesweeper")
	public String toMinesweeper() {
		return "minesweeper";
	}
	
	@PostMapping("/minesweeper/open")
	@ResponseBody
	public MinesweeperResponse openCell(@RequestBody MinesweeperRequest request) {
		
		MinesweeperResponse response = null;
		
		int random = (int)(Math.random() * 4);
		
		if (random == 0) {
			response = new MinesweeperResponse(ResultType.CLEAR, List.of(new OpenCell(0, 8)), List.of(3));
		} else if (random == 1) {
			response = new MinesweeperResponse(ResultType.BLOCK, null, null);
		} else if (random == 2) {
			response = new MinesweeperResponse(ResultType.EXPLOED, null, List.of(3));
		} else {
			response = new MinesweeperResponse(ResultType.OPEN, List.of(new OpenCell(0, 8)), null);
		} 
		return response;
	}
}


