package com.jgames.demo.minesweeper.domain;

public class Cell {
	private CellStatus status;
	private int adjacentMines;
	private boolean mine;
	 
	Cell() {
		this.status = CellStatus.CLOSE;
		this.mine = false;
		this.adjacentMines = 0;
	}
	
	boolean isMine() {
		return this.mine;
	}
	
	void flipMine() {
		this.mine = !mine;
	}
	
	boolean isClose() {
		return this.status == CellStatus.CLOSE;
	}
	
	boolean isOpen() {
		return this.status == CellStatus.OPEN;
	}
	
	boolean isFlag() {
		return this.status == CellStatus.FLAG;
	}
	
	boolean isReveal() {
		return this.status == CellStatus.REVEAL;
	}
}
