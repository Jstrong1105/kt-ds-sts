package com.jgames.demo.minesweeper.domain;

public enum CellStatus {
	CLOSE,
	OPEN,
	FLAG,
	REVEAL;
	
	public CellStatus openCell() { 
		return switch(this) {
			case CLOSE -> OPEN;
			case OPEN -> CLOSE;
			case FLAG -> this;
			case REVEAL -> this; 
		};
	}
	
	public toggleFlag() {
		return switch(this) {
		case CLOSE -> FLAG;
		case OPEN -> this;
		case FLAG -> CLOSE;
		case REVEAL -> this;
		};
	}
}
