function openCells(cells) {
  cells.forEach((eachCell) => {
    const cell = document.querySelector(
      `[data-row="${eachCell.row}"][data-col="${eachCell.col}"]`,
    );

    cell.classList.remove("close-cell");
    cell.classList.add("open-cell");
    cell.dataset.adjacent = eachCell.adjacentMines;

    const adjacentMines = eachCell.adjacentMines;

    // alert(adjacentMines);

    if (adjacentMines != 0) {
      const img = document.createElement("img");
      img.setAttribute("src", `${path}/img/number_${adjacentMines}_icon.svg`);
      cell.append(img);
    }
  });
}

function revealMines(mines) {
  mines.forEach((eachMine) => {
    const cell = document.querySelector(
      `[data-row="${eachMine.row}"][data-col="${eachMine.col}"]`,
    );
    cell.classList.remove("close-cell");
    cell.classList.remove("flag-cell");
    cell.classList.add("reveal-cell");

    const img = document.createElement("img");
    img.setAttribute("src", `${path}/img/mine_icon.svg`);
    cell.innerHTML = "";
    cell.append(img);
  });
}

function clear(result) {
  openCells(result.openCells);
  revealMines(result.mines);
  alert("클리어!");
}

