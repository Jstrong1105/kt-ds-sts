package com.ktdsuniversity.edu.articles.service;

import org.springframework.stereotype.Service;

import com.ktdsuniversity.edu.articles.dao.ArticlesDao;
import com.ktdsuniversity.edu.articles.vo.response.ArticleListVO;

@Service
public class ArticlesServiceImpl implements ArticlesService {
	
	private ArticlesDao articleDao;
	
	public ArticlesServiceImpl(ArticlesDao articleDao) {
		this.articleDao = articleDao;
	}
	
	@Override
	public ArticleListVO readAllArticles() {
		
		ArticleListVO result = null;
		
		result.setArticleCount(this.articleDao.selectArticlesCount());
		result.setArticleList(this.articleDao.selectAllArticles());

		return result;
	}
}
