async function doOpenCell(cell) {
  const path = document.querySelector("body").dataset["contextPath"];
  // console.log(path);
  const pos = cell.dataset.position;

  const option = {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ position: pos, action: "OPEN" }),
  };

  // console.log(`${path}/minesweeper/open`);

  const fetchResult = await fetch(`${path}/minesweeper/open`, option);
  console.log(fetchResult);
  const result = await fetchResult.json();
  console.log(result);

  openCell(result);
}

