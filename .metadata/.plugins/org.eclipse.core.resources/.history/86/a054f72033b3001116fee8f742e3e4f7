<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<!doctype html>
<html>
<head>
<meta charset="UTF-8" />
<title>J-Movies</title>
<!--  <link rel="stylesheet" href="../css/tmdb_common.css" type="text/css" />
    <link rel="stylesheet" href="../css/tmdb_main.css" type="text/css" />
    <script type="text/javascript" src="../javascript/tmdb_main.js"></script> -->

<style type="text/css">
:root {
	--main-background-color: #150f16;
	--header-background-color: #241a25;
	--text-white-color: #ccc;
	--search-background-color: #342635;
	--search-outline-color: #402aa5;
}

* {
	box-sizing: border-box;
}

body {
	margin: 0;
	background-color: var(--main-background-color);
}

.wrapper {
	display: grid;
	grid-template-rows: auto 1fr auto;
	grid-template-columns: auto 1fr;
	grid-template-areas: "header header" "aside content" "footer footer";
	&
	>
	.
	header
	{
	grid-area
	:
	header;
}

&
>
.aside {
	grid-area: aside;
}

&
>
.content {
	grid-area: content;
}

&
>
.footer {
	grid-area: footer;
}

}
.header {
	background-color: var(--header-background-color);
	padding: 1rem;
	display: flex;
	justify-content: space-between; & > . header-left { display : flex;
	align-items: center;
	column-gap: 0.5rem;
	font-size: 1.5rem;
	color: var(--text-white-color); & > img { width : 2rem;
	height: 2rem;
}

&
:hover {
	cursor: pointer;
}

}
&
>
.header-center {
	background-color: var(--search-background-color);
	padding: 0.5rem;
	border-radius: 1rem;
	min-width: 500px;
	display: grid;
	grid-template-columns: 1fr auto;
	column-gap: 0.5rem;
	align-items: center; &:
	has (input: focus){
      outline: 2px solid var(--search-outline-color);
}

&
>
input {
	background-color: var(--search-background-color);
	border: 0;
	color: var(--text-white-color);
	&:
	focus
	{
	outline
	:
	0;
}

&
::placeholder {
	color: var(--text-white-color);
}

}
&
>
img:hover {
	cursor: pointer;
}

}
&
>
.header-right {
	display: flex;
	justify-content: flex-end;
	column-gap: 0.5rem;
	align-items: center; & > . icon { background-color : var(
	--search-background-color);
	padding: 0.5rem;
	border-radius: 1rem;
	transition: background-color 0.5s; &: hover { background-color : var(
	--main-background-color);
	cursor: pointer;
}

&
>
img {
	vertical-align: top;
	width: 2.5rem;
	height: 2.5rem;
}

}
}
}
.aside {
	border-right: 1px solid var(--header-background-color);
	padding: 1rem;
	display: flex;
	flex-direction: column;
	row-gap: 1rem; & > . side-btn { display : flex;
	justify-content: flex-start;
	align-items: center;
	column-gap: 0.5rem;
	padding: 0.5rem;
	border-radius: 1rem;
	background-color: var(--header-background-color);
	color: var(--text-white-color);
	outline: 0; &: hover { outline : 2px solid var( --search-outline-color);
	cursor: pointer;
}

}
}
.footer {
	padding: 1rem;
	background-color: var(--header-background-color);
	text-align: center;
	color: var(--text-white-color);
	font-size: 0.625rem;
	font-weight: bold;
}
</style>

</head>
<body>
	<div class="wrapper">
		<div class="header">
			<div class="header-left">
				<img src="../images/logo-icon.svg" alt="" class="logo-icon" /> <span>J-Movies</span>
			</div>

			<div class="header-center">
				<input type="text" name="kwd" id="kwd" placeholder="영화 검색" /> <img
					src="../images/search-icon.svg" alt="" class="search-icon" />
			</div>

			<div class="header-right">
				<div class="icon">
					<img src="../images/arrow-left-icon.svg" alt="" class="page-before" />
				</div>

				<div class="icon">
					<img src="../images/arrow-right-icon.svg" alt="" class="page-after" />
				</div>

				<div class="icon">
					<img src="../images/home-icon.svg" alt="" class="home-icon" />
				</div>

				<div class="icon">
					<img src="../images/login-icon.svg" alt="" class="login-icon" />
				</div>
			</div>
		</div>

		<div class="aside">
			<div class="side-btn">
				<img src="../images/no-fill-star-icon.svg" alt="" /> <span>인기
					영화</span>
			</div>

			<div class="side-btn">
				<img src="../images/sun-icon.svg" alt="" /> <span>신규 영화</span>
			</div>

			<div class="side-btn">
				<img src="../images/thumb-icon.svg" alt="" /> <span>즐겨찾기</span>
			</div>

			<div class="side-btn">
				<img src="../images/history-icon.svg" alt="" /> <span>최근 시청</span>
			</div>
		</div>

		<div class="content"></div>

		<div class="footer">© 2026. J-Movies. All rights reserved.</div>
	</div>

	<template id="content-item">
		<div class="item" data-movie-id>
			<div class="poster">
				<img src="" alt="" />
			</div>
			<div class="title"></div>
		</div>
	</template>
</body>
</html>
