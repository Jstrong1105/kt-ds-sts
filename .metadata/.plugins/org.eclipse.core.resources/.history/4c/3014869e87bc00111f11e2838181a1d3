import com.ktdsuniversity.edu.replies.vo.response.RepliesVO;

import lombok.AllArgsConstructor;

@AllArgsConstructor
@Service
public class RepliesServiceImpl implements RepliesService {

	private RepliesDao repliesDao;
	
	@Override
	public ReplieListVO readAllReplies(String articleId) {
		ReplieListVO replieListVO = new ReplieListVO();
		
		long count = this.repliesDao.selectReplieCount(articleId);
		
		if (count != 0) {
			replieListVO.setReplieCount(count);
			replieListVO.setReplieList(this.repliesDao.selectAllReplies(articleId));
		}
		
		return replieListVO;
	}
	
	@Override
	public RepliesVO createNewReplie(RegistReplieVO registReplieVO) {
		
		this.repliesDao.insertNewReplie(registReplieVO);
		
		return this.repliesDao.selectReplieByReplieId(registReplieVO.getId());
	}
	
	@Override
	public RepliesVO updateReplie(String replieId, ModifyReplieVO modifyReplieVO) {
