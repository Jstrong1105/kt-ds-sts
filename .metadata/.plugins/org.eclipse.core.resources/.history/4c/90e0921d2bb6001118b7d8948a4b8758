package com.jgames.demo.minesweeper.domain;

import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Deque;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import com.jgames.demo.minesweeper.vo.request.MinesweeperRequest;
import com.jgames.demo.minesweeper.vo.response.MinesweeperResponse;
import com.jgames.demo.minesweeper.vo.response.OpenCell;
import com.jgames.demo.minesweeper.vo.response.ResultType;

public class Board {
	
	private final Map<CellPosition, Cell> board;
	private final List<CellPosition> mines;
	
	private final int[] DIR_ROW = {-1, -1, -1, 1, 0, 0, 1, 1, 1};
	private final int[] DIR_COL = {-1, 0, 1, -1, 1, -1, 0, -1};
	
	private final int row;
	private final int col;
	private final int mineCount;
	
	private Board(int row, int col, int mineCount) {
		
		this.board = new HashMap<>();
		this.mines = new ArrayList<>(); 
		
		this.row = row;
		this.col = col;
		this.mineCount = mineCount;
		
		for (int r = 0; r < row; r++) {
			for (int c = 0; c < col; c++) {
				CellPosition pos = new CellPosition(r, c);
				
				this.board.put(new CellPosition(r,c), new Cell());
				
				mines.add(pos);
			}
		}
		
		Collections.shuffle(this.mines);
		
		this.mines.stream()
		          .limit(mineCount)
		          .map( (p) -> this.board.get(p))
		          .forEach(Cell::flipMine)
		          ;
	}
	
	public static Board reset() {
		return new Board(5,5,5);
	}
	
	public MinesweeperResponse openCell(MinesweeperRequest request) {
		
		MinesweeperResponse response = null;
		CellPosition position = new CellPosition(request.row(), request.col());
		
		Cell cell = this.board.get(position);
		
		if (cell.isFlag() || cell.isOpen()) {
			response = new MinesweeperResponse(ResultType.BLOCK, null, null);
			return response;
		}
		
		if (cell.isMine()) {
			List<CellPosition> minePos = this.mines.stream().limit(this.mineCount).toList();
			response = new MinesweeperResponse(ResultType.EXPLODED, null, minePos);
			return response;
		}
		
		List<OpenCell> openResult = this.open(position);
		
		if (this.isClear()) {
			response = new MinesweeperResponse(ResultType.CLEAR, openResult, mines);
		} else {
			response = new MinesweeperResponse(ResultType.OPEN, openResult, null);
		}
		
		return response;
	}
	
	private List<OpenCell> open(CellPosition pos) {
		
		List<OpenCell> result = new ArrayList<>();
		
		Deque<CellPosition> positions = new ArrayDeque<>();
		positions.add(pos);
		
		while(!positions.isEmpty()) {
			CellPosition position = positions.remove();
			Cell cell = this.board.get(position);
			
			if (!cell.isClose()) {
				continue;
			}
			
			cell.openCell();
			result.add(new OpenCell(position.row(),position.col(),cell.getAdjacentMines()));
			
			if (cell.getAdjacentMines() == 0) {
				for (int i = 0; i < 8; i++) {
					
					int nRow = position.row() + DIR_ROW[i];
					int nCol = position.col() + DIR_COL[i];
					
					positions.add(new CellPosition(nRow,nCol));
				}
			}
		}
		
		return result;
	}
	
	private boolean isClear() {
		return this.board.values().stream()
				                  .allMatch(c -> c.isOpen() || c.isMine())
				                  ;
	}
	
	public boolean toggleFlag(MinesweeperRequest request) {
		return true;
	}
}
