package com.jgames.demo.minesweeper.vo.response;

import java.util.List;

import com.jgames.demo.minesweeper.domain.Cell;

public class MinesweeperResponse {
	
	private ResultType result;
	
	private List<Cell> cells;
	
	private List<Integer> minePosition;

	public ResultType getResult() {
		return this.result;
	}

	public void setResult(ResultType result) {
		this.result = result;
	}

	public List<Cell> getCells() {
		return this.cells;
	}

	public void setCells(List<Cell> cells) {
		this.cells = cells;
	}

	public List<Integer> getMinePosition() {
		return this.minePosition;
	}

	public void setMinePosition(List<Integer> minePosition) {
		this.minePosition = minePosition;
	}
	
	
}
